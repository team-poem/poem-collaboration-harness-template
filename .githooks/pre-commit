#!/bin/sh
# 협업 하네스 pre-commit. 어떤 도구(Claude, Codex, 사람)로 커밋하든 스테이지된 파일에 guard 와 같은 규칙을 건다.
# 활성화: git config core.hooksPath .githooks (init.sh 가 한다)
root="$(git rev-parse --show-toplevel)" || exit 0
[ -f "$root/scripts/collab.sh" ] && { sh "$root/scripts/collab.sh" precommit || exit 1; }
# sobaya 가 붙어 있으면 앱 pre-commit(.git/hooks/pre-commit)을 이어서 실행한다
h="$(git rev-parse --git-common-dir)/hooks/pre-commit"; [ -x "$h" ] && exec "$h"
exit 0
